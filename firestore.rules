rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Google sign-in restricted to these workspace domains, mirrors the
    // client-side check in src/lib/firebase.ts. This is the copy that
    // actually matters, since the client check alone is not enforceable.
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@(acts2[.]network|gpmail[.]org)$');
    }

    match /users/{uid} {
      allow read, write: if isAllowedUser() && request.auth.uid == uid;
    }
  }
}
